PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/loandesk
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173

# First login, created by `npm run seed`
OWNER_EMAIL=you@example.com
OWNER_PASSWORD=ChangeThisPassword123

# In-app due-date notifications: days before the due date (0 = on the due date)
NOTIFY_DAYS_BEFORE=3,0
CRON_SCHEDULE=0 9 * * *
CRON_TIMEZONE=Asia/Kolkata
