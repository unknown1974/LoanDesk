PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/loandesk
JWT_SECRET=change-me-to-a-long-random-string
# Production requires a unique random JWT_SECRET of at least 32 characters.
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173
# In Catalyst set CLIENT_ORIGIN to the exact HTTPS Web Client Hosting origin.
# The API and frontend are deployed separately; do not include /app or a trailing slash.
TRUST_PROXY_HOPS=1
# Keep false locally; Catalyst's gateway supplies CORS headers in AppSail.
CORS_MANAGED_BY_PLATFORM=false

# First login, created by `npm run seed`
OWNER_EMAIL=you@example.com
OWNER_PASSWORD=ChangeThisPassword123

# In-app due-date notifications: days before the due date (0 = on the due date)
NOTIFY_DAYS_BEFORE=3,0
CRON_SCHEDULE=0 9 * * *
CRON_TIMEZONE=Asia/Kolkata
# Local development uses the in-process timer. AppSail sets this to false.
ENABLE_IN_PROCESS_CRON=true
# Required for AppSail: separate random 32+ character secret for Catalyst Cron.
# Configure in the Catalyst console, never in source control or the web client.
JOB_SECRET=
